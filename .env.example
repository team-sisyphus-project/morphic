# Autosquad preview: variables the platform should know about.
# DATABASE_URL is injected by the platform (managed PostgreSQL) and must not be listed here.

# REQUIRED to get answers (the UI itself loads without them)
OPENAI_API_KEY=
TAVILY_API_KEY=

# OPTIONAL defaults so the app boots as-is
DATABASE_SSL_DISABLED=true
ENABLE_AUTH=false
ANONYMOUS_USER_ID=anonymous-user
SEARCH_API=tavily
